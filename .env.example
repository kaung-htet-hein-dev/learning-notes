# --- Vercel + local -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Shared secret for POST /api/revalidate (set the same value locally and on Vercel)
REVALIDATE_SECRET=generate-a-long-random-string

# --- Local only (never add these to Vercel) -----------------------------
# service_role bypasses RLS. Keep it in .env.local on your laptop only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Live site URL, used by scripts to call /api/revalidate and print links
SITE_URL=https://your-app.vercel.app
